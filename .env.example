# ─────────────────────────────────────────────────────────────
# DAILY INTELLIGENCE CONTROL CENTRE — environment template
# Copy to .env.local. NEVER commit .env.local.
# Every variable below is optional except where noted.
# The app runs with ZERO keys in MOCK_DATA mode.
# ─────────────────────────────────────────────────────────────

# ── COST PROTECTION ──────────────────────────────────────────
# Hard architectural switch. When true the app will refuse to call
# any provider that is not on a genuinely free tier, and will refuse
# to fall back to a paid model or paid service. Leave this as true.
FREE_ONLY=true

# Run the whole product on realistic mock data. No keys needed.
MOCK_DATA=true

# ── AI (Google AI Studio free tier) ───────────────────────────
# Create at https://aistudio.google.com/apikey — no billing account needed.
GEMINI_API_KEY=

# Free tier in 2026 covers Flash / Flash-Lite models only.
# Pro models are paid-only and are BLOCKED by this app when FREE_ONLY=true.
# If this exact ID is retired, the app auto-discovers a free Flash model.
GEMINI_MODEL=gemini-flash-lite-latest

# A stronger free model, used only for THE SIGNAL, the brief and the content
# buckets — three calls where one response buys a lot. Per-item interpretation
# stays on the fast model above because it runs 40x per day.
GEMINI_MODEL_DEEP=gemini-3.5-flash

# Thinking models spend ~1000 tokens reasoning before writing, which truncated
# the JSON and silently dropped whole sections to the rules fallback. Off by
# default; set to false only if you have raised the output budget too.
GEMINI_DISABLE_THINKING=true

# Safety valves. The app stops calling AI before these are reached.
AI_MAX_REQUESTS_PER_DAY=1000
AI_MAX_REQUESTS_PER_MONTH=25000
AI_SAFETY_THRESHOLD=0.8

# The free tier limits requests per MINUTE as well as per day. 4000ms between
# calls is about 15/min, which is what stopped roughly a third of each run
# being abandoned on a 429.
AI_MIN_GAP_MS=4000
# How many items reach the model per run.
AI_MAX_ITEMS_PER_RUN=40

# ── YOUTUBE (Data API v3, free tier) ──────────────────────────
# OPTIONAL. Powers "top 5 by views, short and long form" per region — the only
# source that reports what content is actually performing, with the platform's
# own numbers. Without it those four sources report as unavailable; nothing is
# estimated in their place.
# Get it: https://console.cloud.google.com → new project → APIs & Services →
# Library → enable "YouTube Data API v3" → Credentials → Create API key.
# Do NOT attach billing. Free quota is 10,000 units/day; this run costs ~4.
# Note: your Gemini key will NOT work here — AI Studio keys are a different kind.
YOUTUBE_API_KEY=

# ── DATABASE (Supabase free tier) ─────────────────────────────
# Leave blank to use the bundled file/memory store (works locally,
# and on Vercel it degrades to per-invocation memory — see README).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── SLACK (free Slack app, incoming webhook) ──────────────────
# https://api.slack.com/apps -> Incoming Webhooks. Free workspaces included.
SLACK_WEBHOOK_URL=
SLACK_CHANNEL_LABEL=#intelligence

# ── AUTOMATION ────────────────────────────────────────────────
# Shared secret so only your GitHub Action can trigger ingestion.
# Generate: openssl rand -hex 32
CRON_SECRET=

# Public URL of your deployment, used by the GitHub Action and Slack links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Briefing time, IST by default.
BRIEF_HOUR_IST=8
