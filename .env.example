# ─────────────────────────────────────────────────────────────
# DeepField, environment template. Copy to .env.local (never commit it).
# Apart from sign-in, every variable is optional. With none set, Pulse and Explore still read
# Reddit, Hacker News, news, Wikipedia, Google Trends, Bluesky and Mastodon , 
# topics are grouped by keyword and the assistant is off until a model key is set.
# ─────────────────────────────────────────────────────────────

# ── SIGN-IN (required) ────────────────────────────────────────
# Everyone signs in with Google and brings their own keys (the Keys page).
# The keys below in this file are the SERVER's own: only SERVER_KEYS_EMAIL's
# account and the scheduled scan ever use them.
#
# Google Cloud Console → APIs & Services → Credentials → Create credentials →
# OAuth client ID → Web application. Authorised redirect URIs:
#   http://localhost:3000/api/auth/callback
#   https://<your-app>.vercel.app/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs sessions and encrypts the keys users save. Changing it signs
# everyone out and they must re-enter their keys. openssl rand -hex 32
AUTH_SECRET=
# The account allowed to use the server keys below. Default tanish@yaas.studio.
# (OWNER_EMAIL, its old name, still works.) This is not the admin: admin
# access is fixed in lib/auth/admin-email.ts and no setting can change it.
SERVER_KEYS_EMAIL=

# ── AI MODELS (switch between them in the assistant) ─────────
# Best overall, free, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Qwen 3.8, GPT-OSS 120B, fastest, free: https://console.groq.com/keys
GROQ_API_KEY=
# Ultra-fast, free (short context): https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# DeepSeek, Qwen, Llama ":free" models, 50 messages/day: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Free "Experiment" plan: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Grok, PAID, billed to xAI credits: https://console.x.ai
XAI_API_KEY=

# Which model groups scans and writes Explore insights. Free models only;
# blank = the first free model with a key. Ids are in lib/ai/models.ts.
AI_BACKGROUND_MODEL=
# The assistant's default. Blank = first free model with a key.
AI_DEFAULT_MODEL=

# ── DATA ──────────────────────────────────────────────────────
# Optional. Reddit's own API gives live upvote/comment counts on brand-new
# threads; without it counts come from the Arctic Shift archive (~36h lag).
# Create a "script" app at https://www.reddit.com/prefs/apps (since late 2025
# Reddit has to approve new apps first; most setups can leave these blank).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional, free (10,000 units/day): trending + most-viewed videos.
# console.cloud.google.com → enable "YouTube Data API v3" → Credentials → API key.
# Your Gemini key will NOT work here.
YOUTUBE_API_KEY=

# Optional, free: Instagram hashtag search through Meta's official API.
# Needs your own Instagram Business or Creator account linked to a Facebook page,
# a Meta app with instagram_basic, a long-lived access token, and the account's
# Instagram user id. Meta allows 30 distinct hashtags per rolling week.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ── STORAGE ───────────────────────────────────────────────────
# Optional. Without Supabase, data lives in .data/kv.json locally (and in
# per-instance memory on Vercel). Uses the app_settings table in supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── SCHEDULING ────────────────────────────────────────────────
# Lets the GitHub Action rescan without the 10-minute per-niche cooldown.
# Generate: openssl rand -hex 32
CRON_SECRET=
